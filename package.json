{
  "name": "enbuilder-workspace",
  "private": true,
  "workspaces": ["wb-client", "ui-web"],
  "scripts": {
    "build:server": "cargo build --release -p wb-server -p wb-app",
    "build:ui": "npm run build -w ui-web",
    "dev:ui": "npm run dev -w ui-web",
    "test:client": "npm run test -w wb-client",
    "test:ui": "npm run test -w ui-web",
    "typecheck": "npm run typecheck -w wb-client && npm run typecheck -w ui-web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
